---
import type { CollectionEntry } from 'astro:content';
import { url, formatDate } from '../utils';

interface Props {
  posts: CollectionEntry<'writing'>[];
}
const { posts } = Astro.props;
---

<ul class="rows">
  {posts.map((post) => (
    <li>
      <a href={url(`/writing/${post.id}`)}>{post.data.title}</a>
      <time class="meta label" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    </li>
  ))}
</ul>
