---
import Base from '../layouts/Base.astro';
import { now } from '../site.config';
import { formatDate } from '../utils';
---

<Base title="Now" description="What I’m focused on right now.">
  <h1>Now</h1>
  <p class="muted">
    What I’m focused on at the moment. Updated {formatDate(now.updated)}.
  </p>
  <ul>
    {now.items.map((item) => <li>{item}</li>)}
  </ul>
  <p class="muted small">
    This is a <a href="https://nownownow.com/about" target="_blank" rel="noopener">now page</a>.
  </p>
</Base>

<style>
  ul {
    padding-left: 1.1rem;
    margin: 1.5rem 0 2rem;
  }
  li {
    margin-bottom: 0.5rem;
  }
  .small {
    font-size: 0.875rem;
  }
</style>
