---
import Base from '../layouts/Base.astro';
import ProjectList from '../components/ProjectList.astro';
import PostList from '../components/PostList.astro';
import { site, links, now } from '../site.config';
import { getProjects, getPosts } from '../content';
import { url, formatDate } from '../utils';

const projects = (await getProjects()).filter((p) => p.data.featured).slice(0, 4);
const posts = (await getPosts()).slice(0, 3);
---

<Base>
  <section class="intro">
    <h1>{site.name}</h1>
    <p class="tagline">{site.tagline}</p>
    <p>
      This is my corner of the internet: a home for the things I’m building, the work I’ve done, and the
      ideas I’m thinking through. <a href={url('/about')}>More about me →</a>
    </p>
  </section>

  <section>
    <h2 class="label">Now <span class="updated">· {formatDate(now.updated)}</span></h2>
    <ul class="now">
      {now.items.map((item) => <li>{item}</li>)}
    </ul>
    <a class="more" href={url('/now')}>What I’m up to →</a>
  </section>

  {projects.length > 0 && (
    <section>
      <h2 class="label">Projects</h2>
      <ProjectList projects={projects} />
      <a class="more" href={url('/projects')}>All projects →</a>
    </section>
  )}

  {posts.length > 0 && (
    <section>
      <h2 class="label">Writing</h2>
      <PostList posts={posts} />
      <a class="more" href={url('/writing')}>All writing →</a>
    </section>
  )}

  <section>
    <h2 class="label">Elsewhere</h2>
    <p class="elsewhere">
      {links.map((l) => <a href={l.href} rel="me noopener" target="_blank">{l.label}</a>)}
    </p>
  </section>
</Base>

<style>
  .intro h1 {
    font-size: 2.25rem;
    margin-bottom: 0.25rem;
  }
  .tagline {
    font-size: 1.2rem;
    color: var(--muted);
    margin-bottom: 1.5rem;
  }
  .updated {
    text-transform: none;
    letter-spacing: 0;
  }
  .now {
    padding-left: 1.1rem;
    margin: 0 0 0.75rem;
  }
  .more {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .elsewhere {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }
</style>
