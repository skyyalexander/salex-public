---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../content';
import { url, formatDate } from '../../utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
  <a class="back muted" href={url('/writing')}>← Writing</a>
  <article class="prose">
    <h1>{post.data.title}</h1>
    <time class="label" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    <div class="body">
      <Content />
    </div>
  </article>
</Base>

<style>
  .back {
    display: inline-block;
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
    text-decoration: none;
  }
  .body {
    margin-top: 2rem;
  }
</style>
