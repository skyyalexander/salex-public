---
import '../styles/global.css';
import { site, nav, links } from '../site.config';
import { url } from '../utils';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const current = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="wrap site-header">
      <a class="home" href={url('/')}>{site.name}</a>
      <nav aria-label="Main">
        {nav.map((item) => (
          <a href={url(item.href)} aria-current={current.startsWith(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </nav>
    </header>

    <main id="main" class="wrap">
      <slot />
    </main>

    <footer class="wrap site-footer">
      <span>© {new Date().getFullYear()} {site.name}</span>
      <span class="footer-links">
        {links.map((l) => <a href={l.href} rel="me noopener" target="_blank">{l.label}</a>)}
      </span>
    </footer>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: var(--gutter);
    top: 0.5rem;
    background: var(--bg);
    padding: 0.25rem 0.5rem;
  }

  .site-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    padding-top: 2.5rem;
    padding-bottom: 3.5rem;
  }
  .home {
    font-weight: 600;
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: 1.25rem;
    font-size: 0.95rem;
  }
  nav a {
    text-decoration: none;
    color: var(--muted);
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--fg);
  }

  main {
    min-height: 60vh;
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-top: 5rem;
    padding-top: 1.5rem;
    padding-bottom: 2.5rem;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .footer-links {
    display: flex;
    gap: 1rem;
  }
  .footer-links a {
    color: inherit;
  }
</style>
